# All optional. lgprune needs no API keys.

# Default database for report / plan / reclaim (a SQLite path or a postgresql:// URL).
# Prefer PGPASSWORD or ~/.pgpass over a password in the URL; plan files never store it.
LGPRUNE_DB=./agent.sqlite

# Screen language: en or ko (the --lang option wins over this).
LGPRUNE_LANG=en

# Postgres for the test suite. Without it, tests start PGlite from tests/pglite
# (after `npm ci --prefix tests/pglite`), and skip Postgres tests if Node is missing.
# LGPRUNE_TEST_PG_URL=postgresql://postgres:postgres@localhost:5432/postgres
